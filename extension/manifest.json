{
  "manifest_version": 3,
  "name": "Flow2API Companion",
  "version": "2.0.0",
  "description": "Keeps the Flow2API Google session fresh and mints reCAPTCHA tokens.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flow2API Companion"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "js": [
        "trusted_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "options_page": "options.html"
}
